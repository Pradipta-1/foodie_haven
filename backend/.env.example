# Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Use MongoDB Atlas for Render deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/foodie_haven?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/foodie_haven

# JWT Secret for Auth Tokens
JWT_SECRET=super_secret_foodie_jwt_key_replace_in_production

# Frontend Client URL(s) - comma-separated list of allowed origins
# Example: https://foodie-haven.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173

